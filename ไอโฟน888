-- ฟังก์ชันสร้างปุ่มสวิตช์ เปิด/ปิด
local function createToggleButton(btnText, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = MainFrame
    btn.Size = UDim2.new(1, -10, 0, 42)
    btn.Position = UDim2.new(0, 5, 0, 0)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 15
    btn.Text = btnText .. " : [ปิด]"

    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            btn.Text = btnText .. " : [เปิด]"
            btn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
        else
            btn.Text = btnText .. " : [ปิด]"
            btn.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
        end
        callback(state)
    end)
end

-- 2. ฟังก์ชันขโมยไข่อัตโนมัติ (Auto Steal Eggs)
_G.AutoStealEggs = false
createToggleButton("🥚 ขโมยไข่ออโต้", function(enabled)
    _G.AutoStealEggs = enabled
end)

task.spawn(function()
    while true do
        task.wait(0.8)
        if _G.AutoStealEggs then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    -- ค้นหาไข่ในแมพขโมยไข่
                    for _, obj in pairs(workspace:GetDescendants()) do
                        if _G.AutoStealEggs and obj:IsA("Model") then
                            local name = string.lower(obj.Name)
                            if string.find(name, "egg") or string.find(name, "trex") or string.find(name, "rare") or string.find(name, "pet") then
                                local targetPart = obj:FindFirstChild("PrimaryPart") or obj:FindFirstChildWhichIsA("BasePart")
                                if targetPart then
                                    hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                                    task.wait(0.5)
                                    break
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

